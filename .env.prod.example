# EC2 배포 폴더에 .env.prod 로 복사해서 값 채우기 (레포에 올리지 않음)
DJANGO_SETTINGS_MODULE=config.settings.prod
# python -c "import secrets; print(secrets.token_urlsafe(50))" 로 생성
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api.minhodev.shop
CSRF_TRUSTED_ORIGINS=https://api.minhodev.shop
# 프론트 주소. 배포 도메인이 생기면 추가
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# RDS
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
# 운영 Compose는 EC2의 /srv/kitup/rds-ca.pem 파일로 RDS 서버 인증서를 검증한다.

# gunicorn 워커 수 (기본 2)
WEB_CONCURRENCY=2

# AI (재료 추정). 운영에서는 목업이 동작하지 않음
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30

# AI (리포트)
REPORT_REVIEW_PROVIDER=
REPORT_REVIEW_MODEL=
REPORT_REVIEW_API_KEY=
REPORT_IMPROVEMENT_PROVIDER=
REPORT_IMPROVEMENT_MODEL=
REPORT_IMPROVEMENT_API_KEY=
REPORT_AI_TIMEOUT_SECONDS=120
