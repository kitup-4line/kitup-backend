DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-only-change-before-use
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Local development database defaults.
DB_NAME=kitup_local
DB_USER=kitup_local
DB_PASSWORD=kitup_local_password
DB_HOST=127.0.0.1
DB_PORT=5432

# AI
AI_API_KEY=
# 예: claude-sonnet-5-5
AI_MODEL=
AI_TIMEOUT_SECONDS=30
