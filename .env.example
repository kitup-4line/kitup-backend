DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-only-change-before-use
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Local development database defaults.
DB_NAME=kitup_local
DB_USER=kitup_local
DB_PASSWORD=kitup_local_password
DB_HOST=127.0.0.1
DB_PORT=5432

# AI
AI_API_KEY=
# 예: claude-sonnet-5-5
AI_MODEL=
AI_TIMEOUT_SECONDS=30
# 로컬 화면 개발용. True면 AI 대신 목업 결과 저장 (DEBUG일 때만)
AI_MOCK_ENABLED=False

# Reports: anthropic / openai / gemini. 재료 추정의 AI_*와 별도 설정.
REPORT_REVIEW_PROVIDER=
REPORT_REVIEW_MODEL=
REPORT_REVIEW_API_KEY=
REPORT_IMPROVEMENT_PROVIDER=
REPORT_IMPROVEMENT_MODEL=
REPORT_IMPROVEMENT_API_KEY=
# 두 AI 단계가 워커 제한 300초를 공유합니다. 값을 크게 설정하면 최초 호출이나 재시도가 생략될 수 있습니다.
REPORT_AI_TIMEOUT_SECONDS=120
